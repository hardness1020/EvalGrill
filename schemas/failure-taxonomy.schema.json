{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "failure-taxonomy.schema.json",
  "title": "Failure taxonomy (failure-taxonomy.yaml)",
  "type": "object",
  "required": ["schema_version", "failure_modes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "severity", "provenance"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": { "type": "string" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "frequency": { "enum": ["common", "occasional", "rare", "unknown"] },
          "location": {
            "enum": ["final_output", "evidence", "reasoning", "tool_usage", "communication", "environment", "safety"]
          },
          "observable_signals": { "type": "array", "items": { "type": "string" } },
          "evaluation_method": {
            "type": "object",
            "required": ["primary"],
            "additionalProperties": false,
            "properties": {
              "primary": { "enum": ["deterministic", "rubric", "human_review", "outcome"] },
              "secondary": { "type": "string" }
            }
          },
          "provenance": {
            "description": "Free-form grounding pointers (trace, complaint, expert guideline) — NOT the REAL/DERIVED enum, which belongs to tasks and candidates.",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
