{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-dimensions.schema.json",
  "title": "Evaluation dimensions (evaluation-dimensions.yaml)",
  "type": "object",
  "required": ["schema_version", "dimensions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "failure_modes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": { "type": "string" },
          "failure_modes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          }
        }
      }
    }
  }
}
