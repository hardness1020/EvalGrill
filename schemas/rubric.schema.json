{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rubric.schema.json",
  "title": "Rubric (rubric.yaml)",
  "description": "One criteria list, one ID namespace. kind discriminates: ordinal | binary | veto. Vetoes carry no scale or importance — tripping one fails the candidate outright.",
  "type": "object",
  "required": ["schema_version", "criteria"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "layer", "failure_modes", "description", "deterministic", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "kind": { "enum": ["ordinal", "binary", "veto"] },
          "layer": { "enum": ["outcome", "evidence", "communication", "veto"] },
          "failure_modes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          },
          "description": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "importance": { "enum": ["essential", "important", "desirable"] },
          "deterministic": {
            "description": "FR-8: could a script check this instead of a judge?",
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "scale": {
            "description": "Anchor text per level. Keys are contiguous integers from 0.",
            "type": "object",
            "minProperties": 2,
            "propertyNames": { "pattern": "^[0-9]+$" },
            "additionalProperties": { "type": "string" }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "ordinal" } } },
            "then": {
              "required": ["scale", "importance", "why_it_matters"],
              "properties": { "scale": { "minProperties": 3 } }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "binary" } } },
            "then": {
              "required": ["scale", "importance", "why_it_matters"],
              "properties": { "scale": { "minProperties": 2, "maxProperties": 2 } }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "veto" } } },
            "then": {
              "properties": { "scale": false, "importance": false, "layer": { "const": "veto" } }
            }
          }
        ]
      }
    }
  }
}
